---
import type { MLocation } from "./Map.astro";

type Depend = [number, MLocation, DificultyValues | undefined];
export type DificultyKey = keyof typeof dificulties;
export type DificultyValues = (typeof dificulties)[keyof typeof dificulties];

interface Props {
  class?: ClassList;
  location: MLocation;
  locations: MLocation[];
  pos: number;
}

const dificulties = {
  e: "easy",
  n: "normal",
  d: "difficult",
  h: "hard",
  r: "related",
} as const;

const { class: c, location, locations, pos } = Astro.props;
const { id, depends: d, name, sector, status, x, y } = location;
const depends = !d?.length
  ? []
  : ([d]
      .flat()
      .map((key) => {
        if (typeof key === "function") key = key();
        const [id, d] = key.split("-") as [string, DificultyKey | ""];
        const l = locations.find((l) => l.id === id);
        if (!l) return;
        return [locations.indexOf(l!) + 1, l!, d ? dificulties[d] : undefined];
      })
      .filter(Boolean) as Depend[]);
---

<div class:list={["grow flex gap-2 align-middle", c]}>
  <input
    x-ref={`ch${pos}`}
    x-model="checked"
    data-checkbox={pos}
    class="done"
    type="checkbox"
    value={id}
  />
  <label
    title={`${id || ""}`}
    class:list={[
      "flex w-full h-full cursor-pointer grow gap-2 items-center",
      status,
    ]}
    @dblclick={`$refs.ch${pos}.click()`}
  >
    <input
      x-model="radio"
      id={`r-${pos}`}
      data-coord={`${x},${y}`}
      type="radio"
      name="location"
      popovertarget={id ? `tooltip-${pos}` : undefined}
      value={id}
      class:list={["location", sector]}
      @keyup.space={`$refs.ch${pos}.click()`}
      @keydown.arrow-left.shift.prevent="cycleCoords($event.currentTarget, -1)"
      @keydown.arrow-right.shift.prevent="cycleCoords($event.currentTarget, 1)"
    />
    <span data-title>
      {id} - {name}
    </span>
    {
      depends && (
        <span class="depends flex flex-wrap justify-end ml-auto font-oswald">
          {depends.map(([pos, { id, name }, dificulty]) => (
            <label
              for={`r-${pos}`}
              title={`Depends on ${id} - ${name}${dificulty ? ` (${dificulty})` : ""}`}
              class:list={["cursor-pointer", dificulty]}
            >
              [{pos}]
            </label>
          ))}
        </span>
      )
    }
  </label>
</div>
