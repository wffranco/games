---
interface Props {
  class?: ClassList;
  orientacion?: "right" | "left" | "up" | "down";
}

const { class: c, orientacion = "right" } = Astro.props;

const rotaciones: Record<string, number> = {
  right: 0,
  down: 90,
  left: 180,
  up: 270,
};
const rotation = rotaciones[orientacion] ?? 0;
---

<svg
  class:list={["aspect-square", c]}
  viewBox="0 0 20 20"
  xmlns="http://www.w3.org/2000/svg"
>
  <circle cx="10" cy="10" r="9" fill="black" stroke="#666"></circle>
  <g transform={`rotate(${rotation} 10 10)`}>
    <path
      d="M8 5l5 5 -5 5"
      stroke="white"
      stroke-width="2"
      stroke-linecap="butt"
      stroke-linejoin="miter"></path>
  </g>
</svg>
