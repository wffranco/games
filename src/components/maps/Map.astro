---
import Item, { type DificultyKey } from "./Item.astro";
import Mark from "./Mark.astro";

interface Props {
  class?: ClassList;
  colors?: ClassList;
  locations: Location[];
  markSize?: number | [number, number];
  scale?: number;
  store: string;
  translate?: [number, number];
}

type LocationId = `${string}${"" | `-${DificultyKey}`}`;
export interface Location<S = string> {
  id: LocationId;
  sector: S;
  depends?:
    (LocationId | (() => LocationId)) | (LocationId | (() => LocationId))[];
  name: string;
  status?: "important" | "urgent" | "hard" | "careful";
  info?: string | string[];
  type?: string;
  x: number;
  y: number;
  avoid?: number[];
  repeated?: boolean;
}

export type Locations<S, V extends Location<S>> = Record<string, V>;

const {
  class: c,
  colors,
  locations: unmarket,
  markSize,
  scale,
  store,
  translate,
} = Astro.props;
const markSizes = Array.isArray(markSize)
  ? markSize
  : [markSize ?? 1, markSize ?? 1];
const [markX, markY] = markSizes;

export type MLocation = Location & { repeated: boolean };
const marked = (() => {
  const repeated = new Set<string>();
  (() => {
    const check = new Set<string>();
    for (const l of unmarket) {
      const coord = `${l.x},${l.y}`;
      if (check.has(coord)) repeated.add(coord);
      else check.add(coord);
    }
  })();
  return (l: Location): MLocation => ({
    ...l,
    repeated: repeated.has(`${l.x},${l.y}`),
  });
})();
const locations = unmarket.map(marked);
---

<section
  x-data={`{
    cache: {},
    mark: { x: ${markX}, y: ${markY} },
    store: '${store}',
    get checked() { return this.cache?.checked ?? []; },
    set checked(value) {
      this.setCached('checked', value);
      if (this.hide && this.checked.includes(this.radio)) {
        const r = document.querySelector('li:has(input.location[value=' + this.radio + '])~li:not(:has(.done:checked)) input.location');
        if (r) {
          this.radio = r.value;
          r.focus();
        }
      }
    },
    get hide() { return this.cache?.hide ?? false; },
    set hide(value) {
      this.setCached('hide', value);
    },
    get radio() { return this.cache?.radio ?? ''; },
    set radio(value) {
      this.setCached('radio', value);
      if (value) this.centerOn(value);
      else this.resetView();
      this.focusRadio();
    },
    get showAll() { return this.cache?.showAll ?? false; },
    set showAll(value) {
      this.setCached('showAll', value);
    },
    transition: false,
    drag: false,
    dragMoved: false,
    dragX: 0,
    dragY: 0,
    scale: ${scale ?? 1},
    translateX: ${translate?.[0] ?? 0},
    translateY: ${translate?.[1] ?? 0},
    defaultScale: ${scale ?? 1},
    defaultTranslateX: ${translate?.[0] ?? 0},
    defaultTranslateY: ${translate?.[1] ?? 0},
    focus: ${JSON.stringify(Object.fromEntries(locations.map((l) => [l.id, [l.x, l.y]])))},
    focusRadio(id) {
      const r = document.querySelector('li input.location[value="' + (id ?? this.radio) + '"]');
      if (r) r.focus();
    },
    resetView() {
      this.scale = this.defaultScale;
      this.translateX = this.defaultTranslateX;
      this.translateY = this.defaultTranslateY;
    },
    centerOn(id) {
      const viewport = this.$refs.viewport;
      const target = viewport?.querySelector('[data-value="' + id + '"]');
      if (!viewport || !target) {
        const [x, y] = this.focus[id] || [];
        if (x == null) return;
        const tscale = Math.max(this.scale, 2.5);
        this.translateTo(
          50 - 25 / tscale - x - this.mark.x / 2,
          50 - 25 / tscale - y - this.mark.y / 2,
          tscale,
        );
        return;
      }
      const vp = viewport.getBoundingClientRect();
      const W = vp.width;
      const H = vp.height;
      const C = { x: vp.left + W / 2, y: vp.top + H / 2 };
      const O = { x: vp.left + W, y: vp.top + H };
      const r = target.getBoundingClientRect();
      const Q0 = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
      const s0 = this.scale;
      const t0 = { x: 2 * W * this.translateX / 100, y: 2 * H * this.translateY / 100 };
      const p = {
        x: (Q0.x - (1 - s0) * O.x - s0 * t0.x) / s0,
        y: (Q0.y - (1 - s0) * O.y - s0 * t0.y) / s0,
      };
      const s = Math.max(this.scale, 2.5);
      const t = {
        x: (C.x - (1 - s) * O.x) / s - p.x,
        y: (C.y - (1 - s) * O.y) / s - p.y,
      };
      this.translateTo(t.x * 100 / (2 * W), t.y * 100 / (2 * H), s);
    },
    translateTo(x, y, s) {
      if (x === this.translateX && y === this.translateY && s === this.scale) return;
      this.transition = true;
      this.translateX = x;
      this.translateY = y;
      this.scale = s;
    },
    cycleCoords(button, step) {
      const label = button.closest('[data-coord]');
      const coord = label?.dataset.coord;
      if (!coord) return;
      const radios = [...document.querySelectorAll('input[data-coord="' + coord + '"]')];
      if (radios.length < 2) return;
      const i = radios.findIndex((r) => r.value === this.radio);
      if (i < 0) return;
      const next = radios[(i + step + radios.length) % radios.length];
      if (next) this.radio = next.value;
    },
    exactKey(e, m) {
      const k = {alt: false, ctrl: false, meta: false, shift: false, ...m};
      return e.metaKey === k.meta && e.ctrlKey === k.ctrl && e.altKey === k.alt && e.shiftKey === k.shift;
    },
    onClickCapture(e) {
      if (this.dragMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
      this.dragMoved = false;
    },
    onDragStart(e) {
      this.drag = true;
      this.dragMoved = false;
      this.dragX = e.clientX;
      this.dragY = e.clientY;
      e.preventDefault();
    },
    onDragMove(e) {
      if (!this.drag) return;
      const r = this.$refs.viewport.getBoundingClientRect();
      if (Math.abs(e.clientX - this.dragX) + Math.abs(e.clientY - this.dragY) > 4) {
        this.dragMoved = true;
      }
      this.translateX += 50 * (e.clientX - this.dragX) / r.width / this.scale;
      this.translateY += 50 * (e.clientY - this.dragY) / r.height / this.scale;
      this.dragX = e.clientX;
      this.dragY = e.clientY;
    },
    onDragEnd() {
      this.drag = false;
    },
    onWheel(e) {
      const r = e.currentTarget.getBoundingClientRect();
      this.zoomBy(e.deltaY < 0 ? 1.1 : 1 / 1.1, (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
    },
    zoomBy(factor, a = 0.5, b = 0.5) {
      const next = Math.max(0.1, Math.min(20, this.scale * factor));
      const tx = this.translateX + 50 * ((a - 1 + next) / next - (a - 1 + this.scale) / this.scale);
      const ty = this.translateY + 50 * ((b - 1 + next) / next - (b - 1 + this.scale) / this.scale);
      this.translateTo(tx, ty, next);
    },
    zoomIn() { this.zoomBy(1.3); },
    zoomOut() { this.zoomBy(1 / 1.3); },
    loadCache() {
      this.cache = JSON.parse(localStorage.getItem('map-' + this.store)) ?? {};
    },
    saveCache() {
      localStorage.setItem('map-' + this.store, JSON.stringify(this.cache));
    },
    setCached(key, value) {
      this.cache[key] = value;
      this.saveCache();
    },
  }`
    .trim()
    .replace(/\s\s+/g, " ")}
  x-init="
    loadCache();
    $nextTick(() => {
      document.querySelector('.location:checked')?.focus();
      if (radio) centerOn(radio);
    });
  "
  id="locations"
  class:list={[
    "relative group/locations grid grid-cols-[auto_1fr] h-[95vh]",
    c,
  ]}
  @keydown.window.a="if (exactKey($event)) showAll=!showAll;"
  @keydown.window.c="if (exactKey($event)) hide=!hide;"
  @keydown.window.f="if (exactKey($event)) focusRadio();"
  @keydown.window.h="if (exactKey($event)) hide=!hide;"
  @keydown.window.m="if (exactKey($event)) radio = '';"
  @keydown.window.r="if (exactKey($event, {shift: true})) checked=[];"
>
  <nav
    class="relative h-full overflow-y-scroll border text-gray-200 bg-blue-950 w-70 rounded-l text-sm"
  >
    <ul
      role="list"
      class:list={[
        "grid",
        "**:[.urgent_&]:data-title:font-bold",
        colors ?? [
          "**:[:where(.careful,.dificult)_&]:data-title:text-yellow-300",
          "**:[.easy_&]:data-title:text-sky-400",
          "**:[.hard_&]:data-title:text-red-500",
          "**:[.important_&]:data-title:text-green-300",
          "**:[.normal_&]:data-title:text-gray-300",
          "[&_.depends>.easy]:text-green-500",
          "[&_.depends>.normal]:text-blue-500",
          "[&_.depends>.difficult]:text-yellow-500",
          "[&_.depends>.hard]:text-red-500",
          "[&_.depends>.related]:text-cyan-500",
        ],
      ]}
    >
      <li class="sticky top-0 z-30">
        <div class="grid">
          <slot name="header" />
          <div class="flex justify-evenly gap-2 bg-slate-900 p-2">
            <input
              x-model="showAll"
              class="all"
              type="checkbox"
              title="Show All"
            />
            <button
              class="px-2 py-1 border text-xs bg-slate-800"
              @click="checked = []"
            >
              Clear checked
            </button>
            <button
              class="px-2 py-1 border text-xs bg-slate-800"
              @click="radio = '';"
            >
              Clear radio
            </button>
            <input
              x-model="hide"
              type="checkbox"
              class="hide"
              title="Hide completed"
            />
          </div>
        </div>
      </li>
      <li class="px-2 py-1 has-[.all:checked]/li:bg-sky-950">
        <div class="flex">
          <label class="cursor-pointer px-2 py-1 flex gap-2">
            <input type="radio" name="location" value="" x-model="radio" />
            <span>Full Map</span>
          </label>
        </div>
      </li>
      {
        locations.map((location, key) => (
          <li class="relative [li:has(.hide:checked)~&:has(.done:checked)]:hidden has-[.done:checked]:bg-green-950">
            <div class="absolute inset-0 pointer-events-none [li:hover_&]:bg-black/20 [li:has(.location:checked)_&]:bg-white/30 [li:has(.location:checked)_&]:animate-pulse" />
            <div class="flex gap-2 px-2 py-1 items-center">
              <div class="w-8 text-right">{key + 1}.</div>
              <Item {...{ location, locations }} pos={key + 1} />
            </div>
          </li>
        ))
      }
    </ul>
  </nav>
  <div
    x-ref="viewport"
    class="relative h-full aspect-square border overflow-hidden select-none cursor-grab active:cursor-grabbing bg-black"
    @wheel.prevent="onWheel"
    @mousedown="onDragStart"
    @mousemove.window="onDragMove"
    @mouseup.window="onDragEnd"
    @click.capture="onClickCapture"
  >
    <div class="absolute top-2 right-2 z-30 flex gap-2">
      <button
        class="grid place-items-center size-8 rounded border text-md font-bold text-gray-800 dark:text-gray-100 bg-white/80 dark:bg-gray-900/80 shadow hover:bg-white dark:hover:bg-gray-700 select-none"
        type="button"
        title="Zoom in"
        @click="zoomIn()"
      >
        <span class="translate-y-[-1px]">+</span>
      </button>
      <button
        class="grid place-items-center size-8 rounded border text-md font-bold text-gray-800 dark:text-gray-100 bg-white/80 dark:bg-gray-900/80 shadow hover:bg-white dark:hover:bg-gray-700 select-none"
        type="button"
        title="Zoom out"
        @click="zoomOut()"
      >
        <span class="translate-y-[-1px]">−</span>
      </button>
    </div>
    <div
      id="map-container"
      class="absolute top-0 left-0 h-[200%] w-[200%]"
      :class="{'transition-transform duration-300 ease-out': transition}"
      :style="{transform: `scale(${scale}) translate(${translateX}%, ${translateY}%)`}"
      @transitionend="transition = false"
    >
      <div
        id="map"
        class="absolute inset-0 bg-contain bg-no-repeat bg-center"
        :class="{all: showAll}"
      >
        <slot name="map" />
        {
          locations.map((location, key) => (
            <Mark location={location} pos={key + 1} size={markSize} />
          ))
        }
      </div>
    </div>
  </div>
</section>
