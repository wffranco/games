---
import Layout from "@/layouts/Layout.astro";
import Map from "@/components/maps/Map.astro";
import Orders from "@/components/maps/Orders.astro";
import { orders, type Order, sort } from "@/data/super-metroid/locations";

export const getStaticPaths = async () => [
  { params: { order: undefined } },
  ...orders.map(({ value }) => ({ params: { order: value } })),
];

interface Params {
  order?: Order;
}

const { order = "chrono" } = Astro.params as Params;

const locations = sort(order);
---

<Layout title="Super Metroid - SNES">
  <main class="mx-auto w-max p-3 grid gap-3">
    <Map
      locations={locations}
      markSize={1.6}
      store="sm"
      scale={0.5}
      translate={[-50, -50]}
    >
      <div slot="header" class="grid gap-2 p-2 bg-gray-800">
        <h1 class="text-3xl font-bold text-center">Super Metroid</h1>
        <Orders options={orders} value={order} />
      </div>
    </Map>
  </main>
</Layout>

<style>
  main {
    section {
      #map {
        background-image: url("/games/imgs/super-metroid-map.gif");
      }
    }
  }
</style>
