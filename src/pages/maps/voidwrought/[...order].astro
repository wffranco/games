---
import Layout from "@/layouts/Layout.astro";
import Map from "@/components/maps/Map.astro";
import { orders, type Order, sortedBy } from "@/data/voidwrought/locations";
import { sectors } from "@/data/voidwrought/item-groups";

export const getStaticPaths = async () =>
  orders.map(({ value }) => ({ params: { order: value } }));

interface Params {
  order?: Order;
}

const { order } = Astro.params as Params;

const locations = sortedBy(order);

const link = (value: Order) =>
  ["/games/maps/voidwrought", value].filter(Boolean).join("/");

const name = (sector: string) =>
  sector
    .replace(/[^a-z]/g, " ")
    .trim()
    .replace(/^\w/g, (char) => char.toUpperCase());
---

<Layout title="Voidwrought - PC">
  <main class="mx-auto w-max p-3 grid gap-3">
    <h1 class="text-3xl font-bold text-center">
      Voidwrought {order && `(${order})`}
    </h1>
    <nav>
      <ul class="w-full flex justify-around">
        {
          orders.map(({ name, value }) => (
            <li>
              <a
                href={link(value)}
                class="border px-2 py-1 rounded bg-white/10 hover:bg-white/20"
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Map
      locations={locations}
      markSize={1.1}
      store="vw"
      scale={0.5}
      translate={[-50, -50]}
    >
      {
        sectors.map((sector) => (
          <h2 slot="map" id={sector}>
            {name(sector.replace(/-[0-9]+$/g, ""))}
          </h2>
        ))
      }
    </Map>
  </main>
</Layout>

<style>
  main {
    section {
      #map-container {
        background: black;
        #map {
          background-image: url("/games/imgs/voidwrought/map.png");
          label {
            .location {
              @apply border-3 border-transparent bg-center bg-contain bg-no-repeat translate-x-[0.5px] z-[2];
              /* Image Items */
              &.artifact-fragment {
                background-image: url("/games/imgs/voidwrought/artifact-fragment.png");
              }
              &.devotee {
                background-image: url("/games/imgs/voidwrought/devotee.png");
              }
              &.dormant-salt-receptable {
                background-image: url("/games/imgs/voidwrought/dormant-salt-receptacle.png");
              }
              &.metal-ingot {
                background-image: url("/games/imgs/voidwrought/metal-ingot.png");
              }
              &.relic {
                background-image: url("/games/imgs/voidwrought/relic.png");
              }
              &.shard-of-vitae {
                background-image: url("/games/imgs/voidwrought/shard-of-vitae.png");
              }
              &.simulacrum {
                background-image: url("/games/imgs/voidwrought/simulacrum.png");
              }
              &.soul {
                background-image: url("/games/imgs/voidwrought/soul.png");
              }
            }
          }
          h2 {
            font-weight: 700;
            max-width: 8rem;
            @apply absolute text-center -translate-x-1/2 -translate-y-1/2;
            /* Sector titles */
            &#the-abandoned-expedition {
              color: rgb(173, 170, 161);
              @apply top-[45.6%] left-[55.5%];
            }
            &#the-commons {
              color: rgb(181, 136, 226);
              @apply top-[64%] left-[33%];
            }
            &#the-court {
              color: rgb(63, 156, 81);
              @apply top-[46.5%] left-[24%];
            }
            &#the-grand-bazaar {
              color: rgb(209, 109, 109);
              @apply top-[70%] left-[52%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-lost-garden-1,
            &#the-lost-garden-2 {
              color: rgb(178, 138, 52);
            }
            &#the-lost-garden-1 {
              @apply top-[55.8%] left-[83%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-lost-garden-2 {
              @apply top-[62.5%] left-[74%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-mirrorways {
              color: rgb(80, 140, 153);
              @apply top-[50%] left-[6.5%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-obsidian-observatory {
              color: rgb(181, 92, 210);
              @apply top-[32%] left-[87%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-old-waters-1,
            &#the-old-waters-2,
            &#the-old-waters-3 {
              color: rgb(94, 182, 201);
            }
            &#the-old-waters-1 {
              @apply top-[51%] left-[36%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-old-waters-2 {
              max-width: 6rem;
              @apply top-[46.5%] left-[45.3%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-old-waters-3 {
              @apply top-[58%] left-[70.4%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-repository-of-the-unknown-1,
            &#the-repository-of-the-unknown-2 {
              color: rgb(150, 166, 30);
            }
            &#the-repository-of-the-unknown-1 {
              max-width: 15rem;
              @apply top-[75%] left-[70.1%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-repository-of-the-unknown-2 {
              @apply top-[70%] left-[92.7%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-shrine {
              color: rgb(94, 31, 120);
              @apply top-[57%] left-[49%] -translate-x-1/2 -translate-y-1/2;
            }
            &#the-surface {
              color: rgb(137, 39, 39);
              @apply top-[36%] left-[54%] -translate-x-1/2 -translate-y-1/2;
            }
          }
        }
      }
      &:has(.hide:checked) {
        nav > ul > li:has(.done:checked) {
          @apply hidden;
        }
      }
    }
  }
</style>
